# Public URL of the site, used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.nl

# Mail: leave empty to log submissions to the server console.
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# MAIL_FROM="Studio NewEra <aanvragen@example.nl>"
# MAIL_TO=aanvragen@example.nl

