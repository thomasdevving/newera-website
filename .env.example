# SMTP_PASSWORD=

# Storage: leave empty to discard uploads after validation.
# STORAGE_PROVIDER=s3 | supabase | azure
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=
